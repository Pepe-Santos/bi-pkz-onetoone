graph "conformidade" {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=0.85,
         bgcolor="#FAFAF8", fontname="Helvetica", fontsize=34, pad=0.5,
         label=<<B>6 &#183; Documentos, Conformidade e Comunicação</B><BR/><BR/><FONT POINT-SIZE="20" COLOR="#6A6A6A">Emissão e Envio são o objetivo final do projeto e não existiam no modelo. Consentimento não existe no banco e a LGPD exige.<BR/>Arquivo: relatório, avaliação e atendimento são exclusivos entre si; o atleta acompanha qualquer um deles (M20).<BR/>v2 (16/10/2026): em verde, o que mudou na construção do banco. Os códigos M remetem ao registro de mudanças.</FONT><BR/> >,
         labelloc=t, fontcolor="#2B2B2B"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#5A5A5A", penwidth=1.1,
        fontcolor="#444444", labeldistance=1.5, labelfloat=false];
  ATLETA [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="ATLETA", margin="0.18,0.10"];
  PESSOA [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="PESSOA", margin="0.18,0.10"];
  USUARIO [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="USUÁRIO", margin="0.18,0.10"];
  ARQUIVO [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="ARQUIVO", margin="0.18,0.10"];
  CONSENT [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="CONSENTIMENTO", margin="0.18,0.10"];
  EMISSAO [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="EMISSÃO DE
RELATÓRIO", margin="0.18,0.10"];
  ENVIO [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="ENVIO", margin="0.18,0.10", peripheries=2];
  NOTIF [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="NOTIFICAÇÃO", margin="0.18,0.10"];
  HIST [shape=box, style="filled,rounded,dashed", fillcolor="#EFEBE0", color="#2F7D62", penwidth=2.2, label=<HISTÓRICO<BR/>(derivado)<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M21</B></FONT>>, margin="0.18,0.10"];
  RELAT [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="RELATÓRIO", margin="0.18,0.10"];
  AVAL [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="AVALIAÇÃO", margin="0.18,0.10"];
  ATEND [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="ATENDIMENTO", margin="0.18,0.10"];
  AUDIT [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="AUDITORIA", margin="0.18,0.10"];
  R_anexa [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#2F7D62", penwidth=2.2, label=<anexado a<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M20</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  R_anexaR [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="anexado a", fontsize=10, margin="0.02,0.02"];
  R_anexaV [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="anexado a", fontsize=10, margin="0.02,0.02"];
  R_anexaT [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="anexado a", fontsize=10, margin="0.02,0.02"];
  R_concede [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="concede", fontsize=10, margin="0.02,0.02"];
  R_sobre [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="sobre", fontsize=10, margin="0.02,0.02"];
  R_emitido [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="emitido para", fontsize=10, margin="0.02,0.02"];
  R_expedido [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="expedido", fontsize=10, margin="0.02,0.02", peripheries=2];
  R_destina [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="destinatário", fontsize=10, margin="0.02,0.02"];
  R_notifica [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="notifica", fontsize=10, margin="0.02,0.02"];
  R_regista [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="registra", fontsize=10, margin="0.02,0.02"];
  R_executa [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#2F7D62", penwidth=2.2, label=<executa<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M22</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  ar_id [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label=<<U>id_arquivo</U>>, height=0.30, margin="0.04,0.02", style="filled,solid"];
  ar_tipo [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="tipo", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ar_conf [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="confidencialidade", height=0.30, margin="0.04,0.02", style="filled,solid"];
  cs_fin [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="finalidade", height=0.30, margin="0.04,0.02", style="filled,solid"];
  cs_data [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="data", height=0.30, margin="0.04,0.02", style="filled,solid"];
  cs_canal [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="canal", height=0.30, margin="0.04,0.02", style="filled,solid"];
  em_comp [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="competência", height=0.30, margin="0.04,0.02", style="filled,solid"];
  em_ger [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="gerado_em", height=0.30, margin="0.04,0.02", style="filled,solid"];
  en_canal [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label=<<U>canal</U>>, height=0.30, margin="0.04,0.02", style="filled,solid"];
  en_est [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="estado", height=0.30, margin="0.04,0.02", style="filled,solid"];
  en_erro [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="erro", height=0.30, margin="0.04,0.02", style="filled,solid"];
  h_tipo [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="tipo_evento", height=0.30, margin="0.04,0.02", style="filled,solid"];
  h_data [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="data", height=0.30, margin="0.04,0.02", style="filled,solid"];
  au_ent [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="entidade_auditada", height=0.30, margin="0.04,0.02", style="filled,solid"];
  au_data [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="data", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ARQUIVO:sw -- R_anexa [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_anexa -- ATLETA [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  ARQUIVO:s -- R_anexaR [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_anexaR -- RELAT [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  ARQUIVO:se -- R_anexaV [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_anexaV -- AVAL [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  ARQUIVO:e -- R_anexaT [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_anexaT -- ATEND [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  PESSOA -- R_concede [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_concede -- CONSENT [taillabel="(1,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  CONSENT -- R_sobre [taillabel="(1,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_sobre -- ATLETA [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  ATLETA -- R_emitido [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  R_emitido -- EMISSAO [taillabel="(1,1)", labeldistance=2.6, labelangle=12];
  EMISSAO -- R_expedido [taillabel="(1,N)", labeldistance=2.6, labelangle=12, penwidth=1.9];
  R_expedido -- ENVIO [taillabel="(1,1)", labeldistance=2.6, labelangle=12, penwidth=1.9];
  ENVIO -- R_destina [taillabel="(N,1)", labeldistance=2.6, labelangle=12];
  R_destina -- PESSOA [taillabel="(1,1)", labeldistance=2.6, labelangle=12];
  USUARIO -- R_notifica [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_notifica -- NOTIF [taillabel="(1,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  ATLETA -- R_regista [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  R_regista -- HIST [taillabel="(1,1)", labeldistance=2.6, labelangle=12, color="#2F7D62", penwidth=1.6, labelfontcolor="#2F7D62"];
  USUARIO -- R_executa [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_executa -- AUDIT [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#2F7D62", penwidth=1.6, labelfontcolor="#2F7D62"];
  ARQUIVO -- ar_id [color="#A8A8A8", penwidth=0.85];
  ARQUIVO -- ar_tipo [color="#A8A8A8", penwidth=0.85];
  ARQUIVO -- ar_conf [color="#A8A8A8", penwidth=0.85];
  CONSENT -- cs_fin [color="#A8A8A8", penwidth=0.85];
  CONSENT -- cs_data [color="#A8A8A8", penwidth=0.85];
  CONSENT -- cs_canal [color="#A8A8A8", penwidth=0.85];
  EMISSAO -- em_comp [color="#A8A8A8", penwidth=0.85];
  EMISSAO -- em_ger [color="#A8A8A8", penwidth=0.85];
  ENVIO -- en_canal [color="#A8A8A8", penwidth=0.85];
  ENVIO -- en_est [color="#A8A8A8", penwidth=0.85];
  ENVIO -- en_erro [color="#A8A8A8", penwidth=0.85];
  HIST -- h_tipo [color="#A8A8A8", penwidth=0.85];
  HIST -- h_data [color="#A8A8A8", penwidth=0.85];
  AUDIT -- au_ent [color="#A8A8A8", penwidth=0.85];
  AUDIT -- au_data [color="#A8A8A8", penwidth=0.85];
  R_enviado [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<enviado por<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M20</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  USUARIO -- R_enviado [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  R_enviado -- ARQUIVO [taillabel="(0,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  ACESSO [shape=box, style="filled,rounded", fillcolor="#DCEFE7", color="#2F7D62", penwidth=2.2, label=<ACESSO A DADO<BR/>SENSÍVEL<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M23</B></FONT>>, margin="0.18,0.10"];
  R_consulta [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<consulta<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M23</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  R_sobreAc [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<sobre<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M23</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  ac_ent [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="entidade", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ac_fin [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="finalidade", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ac_em [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="acessado_em", height=0.30, margin="0.04,0.02", style="filled,solid"];
  USUARIO -- R_consulta [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6, style=dashed];
  R_consulta -- ACESSO [taillabel="(1,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6, style=dashed];
  ATLETA -- R_sobreAc [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6, style=dashed];
  R_sobreAc -- ACESSO [taillabel="(0,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6, style=dashed];
  ACESSO -- ac_ent [color="#2F7D62", penwidth=0.9];
  ACESSO -- ac_fin [color="#2F7D62", penwidth=0.9];
  ACESSO -- ac_em [color="#2F7D62", penwidth=0.9];
  R_geraArq [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<gera<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M24</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  EMISSAO -- R_geraArq [taillabel="(0,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
