graph "agenda" {
  graph [rankdir=TB, splines=spline, nodesep=0.6, ranksep=0.85,
         bgcolor="#FAFAF8", fontname="Helvetica", fontsize=24, pad=0.5,
         label=<<B>3 &#183; Agenda e Treino</B><BR/><BR/><FONT POINT-SIZE="14" COLOR="#6A6A6A">training_slots está morto (1 linha; slot_id nulo em 536/536). Disponibilidade vira grade + bloqueio.<BR/>Item de Catálogo substitui as 7 dimensões de texto livre do relatório e os campos _other.<BR/>v2 (16/10/2026): em verde, o que mudou na construção do banco. Os códigos M remetem ao registro de mudanças.</FONT><BR/> >,
         labelloc=t, fontcolor="#2B2B2B"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#5A5A5A", penwidth=1.1,
        fontcolor="#444444", labeldistance=1.5, labelfloat=false];
  UNIDADE [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="UNIDADE", margin="0.18,0.10"];
  ATLETA [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="ATLETA", margin="0.18,0.10"];
  PROF [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="PROFISSIONAL", margin="0.18,0.10"];
  SERVICO [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="SERVIÇO", margin="0.18,0.10"];
  GRADE [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="HORÁRIO
DE GRADE", margin="0.18,0.10"];
  BLOQUEIO [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="BLOQUEIO", margin="0.18,0.10"];
  AGEND [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#2F7D62", penwidth=2.2, label=<AGENDAMENTO<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M9</B></FONT>>, margin="0.18,0.10"];
  SESSAO [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="SESSÃO
DE TREINO", margin="0.18,0.10"];
  RELAT [shape=box, style="filled,rounded", fillcolor="#EFEBE0", color="#8A7F66", penwidth=1.7, label="RELATÓRIO", margin="0.18,0.10"];
  FEEDB [shape=box, style="filled,rounded", fillcolor="#F3F3F1", color="#AFAFAF", penwidth=1.7, label="FEEDBACK
(legado)", margin="0.18,0.10", fontcolor="#7A7A7A"];
  CATALOGO [shape=box, style="filled,rounded", fillcolor="#E4E0F5", color="#6B5FA8", penwidth=1.7, label="ITEM DE
CATÁLOGO", margin="0.18,0.10"];
  R_oferece [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#2F7D62", penwidth=2.2, label=<oferece<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M8</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  R_suspende [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="suspende", fontsize=10, margin="0.02,0.02"];
  R_origina [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="origina", fontsize=10, margin="0.02,0.02"];
  R_reserva [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="reserva", fontsize=10, margin="0.02,0.02"];
  R_conduz [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="conduz", fontsize=10, margin="0.02,0.02"];
  R_tipo [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="é do tipo", fontsize=10, margin="0.02,0.02"];
  R_produz [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#2F7D62", penwidth=2.2, label=<produz<BR/>(só treino)<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M13</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  R_documenta [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="documenta", fontsize=10, margin="0.02,0.02"];
  R_avalia [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="avalia", fontsize=10, margin="0.02,0.02"];
  R_classifica [shape=diamond, style=filled, fillcolor="#FBEFD3", color="#B9963F", penwidth=1.3, label="classificado por", fontsize=10, margin="0.02,0.02"];
  g_dia [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="dia_semana", height=0.30, margin="0.04,0.02", style="filled,solid"];
  g_hora [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="hora_início", height=0.30, margin="0.04,0.02", style="filled,solid"];
  g_vig [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="vigência", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ag_id [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label=<<U>id_agendamento</U>>, height=0.30, margin="0.04,0.02", style="filled,solid"];
  ag_dh [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.0, fontsize=9, label="data", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ag_st [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="status", height=0.30, margin="0.04,0.02", style="filled,solid"];
  b_data [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="data", height=0.30, margin="0.04,0.02", style="filled,solid"];
  b_mot [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="motivo", height=0.30, margin="0.04,0.02", style="filled,solid"];
  rl_id [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label=<<U>id_relatório</U>>, height=0.30, margin="0.04,0.02", style="filled,solid"];
  rl_data [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="data", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ct_id [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label=<<U>id_item</U>>, height=0.30, margin="0.04,0.02", style="filled,solid"];
  ct_dom [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="domínio", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ct_val [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="valor", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ct_ativo [shape=ellipse, style="filled", fillcolor="#FFFFFF", color="#9A9A9A", penwidth=1.0, fontsize=9, label="ativo", height=0.30, margin="0.04,0.02", style="filled,solid"];
  UNIDADE -- R_oferece [taillabel="(1,N)", labeldistance=2.6, labelangle=12];
  R_oferece -- GRADE [taillabel="(0,1)", labeldistance=2.6, labelangle=12, color="#2F7D62", penwidth=1.6, labelfontcolor="#2F7D62"];
  BLOQUEIO -- R_suspende [taillabel="(1,N)", labeldistance=2.6, labelangle=12];
  R_suspende -- GRADE [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  GRADE -- R_origina [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_origina -- AGEND [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  ATLETA -- R_reserva [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  R_reserva -- AGEND [taillabel="(1,1)", labeldistance=2.6, labelangle=12];
  PROF -- R_conduz [taillabel="(0,N)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_conduz -- AGEND [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  SERVICO -- R_tipo [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  R_tipo -- AGEND [taillabel="(1,1)", labeldistance=2.6, labelangle=12];
  AGEND:sw -- R_produz [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_produz -- SESSAO [taillabel="(1,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  AGEND:s -- R_documenta [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  R_documenta -- RELAT [taillabel="(0,1)", labeldistance=2.6, labelangle=12];
  AGEND:se -- R_avalia [taillabel="(0,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  R_avalia -- FEEDB [taillabel="(1,1)", labeldistance=2.6, labelangle=12, style=dashed, color="#B9963F"];
  RELAT -- R_classifica [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  R_classifica -- CATALOGO [taillabel="(0,N)", labeldistance=2.6, labelangle=12];
  GRADE -- g_dia [color="#A8A8A8", penwidth=0.85];
  GRADE -- g_hora [color="#A8A8A8", penwidth=0.85];
  GRADE -- g_vig [color="#A8A8A8", penwidth=0.85];
  AGEND -- ag_id [color="#A8A8A8", penwidth=0.85];
  AGEND -- ag_dh [color="#2F7D62", penwidth=0.9];
  AGEND -- ag_st [color="#A8A8A8", penwidth=0.85];
  BLOQUEIO -- b_data [color="#A8A8A8", penwidth=0.85];
  BLOQUEIO -- b_mot [color="#A8A8A8", penwidth=0.85];
  RELAT -- rl_id [color="#A8A8A8", penwidth=0.85];
  RELAT -- rl_data [color="#A8A8A8", penwidth=0.85];
  CATALOGO -- ct_id [color="#A8A8A8", penwidth=0.85];
  CATALOGO -- ct_dom [color="#A8A8A8", penwidth=0.85];
  CATALOGO -- ct_val [color="#A8A8A8", penwidth=0.85];
  CATALOGO -- ct_ativo [color="#A8A8A8", penwidth=0.85];
  g_cap [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="capacidade", height=0.30, margin="0.04,0.02", style="filled,solid"];
  g_int [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="intervalo_min", height=0.30, margin="0.04,0.02", style="filled,solid"];
  GRADE -- g_cap [color="#2F7D62", penwidth=0.9];
  GRADE -- g_int [color="#2F7D62", penwidth=0.9];
  ag_hi [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="hora_início", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ag_hf [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="hora_fim", height=0.30, margin="0.04,0.02", style="filled,solid"];
  AGEND -- ag_hi [color="#2F7D62", penwidth=0.9];
  AGEND -- ag_hf [color="#2F7D62", penwidth=0.9];
  LISTA [shape=box, style="filled,rounded", fillcolor="#DCEFE7", color="#2F7D62", penwidth=2.2, label=<LISTA DE<BR/>ESPERA<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M10</B></FONT>>, margin="0.18,0.10"];
  R_aguarda [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<aguarda<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M10</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  R_paraLE [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<para<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M10</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  le_data [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="data_hora", height=0.30, margin="0.04,0.02", style="filled,solid"];
  le_st [shape=ellipse, fillcolor="#FFFFFF", color="#2F7D62", fontcolor="#2F7D62", penwidth=1.2, fontsize=9, label="status", height=0.30, margin="0.04,0.02", style="filled,solid"];
  ATLETA -- R_aguarda [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  R_aguarda -- LISTA [taillabel="(1,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  SERVICO -- R_paraLE [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  R_paraLE -- LISTA [taillabel="(1,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  LISTA -- le_data [color="#2F7D62", penwidth=0.9];
  LISTA -- le_st [color="#2F7D62", penwidth=0.9];
  R_valeU [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<vale para<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M11</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  R_valeS [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<vale para<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M11</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  UNIDADE -- R_valeU [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  R_valeU -- BLOQUEIO [taillabel="(0,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  SERVICO -- R_valeS [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  R_valeS -- BLOQUEIO [taillabel="(0,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  R_sobreRel [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<sobre<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M12</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  R_escreve [shape=diamond, style=filled, fillcolor="#E3F3EC", color="#2F7D62", penwidth=1.6, label=<escreve<BR/><FONT POINT-SIZE="8" COLOR="#2F7D62"><B>M12</B></FONT>>, fontsize=10, margin="0.02,0.02"];
  ATLETA -- R_sobreRel [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  R_sobreRel -- RELAT [taillabel="(1,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6];
  PROF -- R_escreve [taillabel="(0,N)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6, style=dashed];
  R_escreve -- RELAT [taillabel="(0,1)", labeldistance=2.6, labelangle=12, labelfontcolor="#2F7D62", color="#2F7D62", penwidth=1.6, style=dashed];
}
