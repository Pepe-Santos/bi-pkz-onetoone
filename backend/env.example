# Copie para backend/.env e preencha. O .env NUNCA vai para o GitHub.
# Projeto Supabase: o de ensaio do Lucas (ref jhspjkelmnbvrnleawwf), o mesmo do banco novo
# do grupo de Dados. A string de conexão fica em "Connect", no painel do Supabase.
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.xxxx.supabase.co:5432/postgres

# API (usada pelo gerador de relatórios, SOMENTE backend)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Teste de acesso (backend/scripts/testar_acesso.py)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
API_TESTE_EMAIL=
API_TESTE_SENHA=

# Envio dos relatórios por e-mail (relatorios/enviar_email.py), pelo SMTP do Gmail.
# EMAIL_SENHA_APP é uma senha de app da conta (Conta Google → Segurança → Verificação em
# duas etapas → Senhas de app), não a senha normal.
EMAIL_USUARIO=
EMAIL_SENHA_APP=
# Modo teste: só estes e-mails recebem, separados por vírgula (os do grupo, nunca os do banco)
EMAILS_TESTE=
